<string name="app_bell_allow_notifications">ベルを使うには Yuno の通知を許可してください。</string>
    <!-- Notifications are off in Android's settings; the settings page opens next. -->
    <string name="app_bell_turn_on_notifications">ベルを使うには Yuno の通知をオンにしてください。</string>

