    <string name="onboarding_account_signed_in_title">ログインしています</string>
    <string name="onboarding_account_title">アカウントを接続</string>
    <string name="onboarding_account_signed_in_body">ホーム・登録チャンネル・履歴・再生リストがこの端末で同期されます。</string>
